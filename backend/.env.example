# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Worker Settings
WORKER_POLL_INTERVAL=3.0
MAX_PROCESSING_ATTEMPTS=3
TEMP_MEDIA_DIR=/tmp/reelvault

# Transcription Settings
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4

# AI Analysis (gemini, groq, ollama, or openai)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.0-flash

# Instagram Authentication (Optional for public reels, recommended for reliable downloads)
INSTAGRAM_COOKIES_PATH=./secrets/cookies.txt

# API Protection for MVP
API_KEY=reelvault-secret-api-key
